---
import "../styles/global.css";
import SiteMeta from "../components/SiteMeta.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fontStylesheet = "https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <SiteMeta title={title} description={description} noindex={noindex} />
    <title>{title}</title>
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" href={fontStylesheet} as="style" />
    <link href={fontStylesheet} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={fontStylesheet} rel="stylesheet" /></noscript>
  </head>
  <body>
    <slot />
    <ConsentBanner />
  </body>
</html>
