---
import type { HomeBlock, Service } from "../lib/sanity/types";
import { experienceHref, imageAlt, localImages } from "../lib/site";
import { sanityImageUrl } from "../lib/sanity";

interface Props { block?: HomeBlock; services: Service[] }
const { block, services } = Astro.props;
const hasExplicitSelection = Boolean(block?.featuredServices?.length);
const items = (hasExplicitSelection ? services : services.filter((service) => service.featured))
  .sort((a, b) => Number(b.name.toLowerCase().includes("boho spa day")) - Number(a.name.toLowerCase().includes("boho spa day")))
  .slice(0, 3);
---

<section class="section experiences-section" id="experiencias" aria-labelledby="experiences-title">
  <div class="section-heading"><div><p class="eyebrow">{block?.eyebrow || "Experiencias Boho"}</p><h2 id="experiences-title">{block?.title || "Experiencias que se disfrutan sin apuro"}</h2></div><p>{block?.description || "Recorridos integrales para regalarte una pausa completa o compartirla con alguien más."}</p></div>
  {items.length > 0 && <div class="experience-list">
    {items.map((service, index) => {
      const fallbackImages = service.slug === "boho-spa-day"
        ? "/images/categories/experiencias-ritual.webp"
        : service.slug === "experiencia-summer"
          ? "/images/categories/facial-protocolo.webp"
          : service.slug === "experiencia-armonia"
            ? "/images/categories/masaje-renovacion.webp"
            : [localImages.experiences, "/images/categories/facial-protocolo.webp", "/images/categories/masaje-renovacion.webp"][index];
      const image = sanityImageUrl(service.mainImage, { width: 1100, quality: 76 }) || fallbackImages;
      return <article class={`experience-item experience-item-${index + 1} ${index === 0 ? "experience-primary" : "experience-secondary"}`}>
        <div class="image-frame"><img src={image} alt={imageAlt(service.mainImage, service.name)} width="1100" height="820" loading="lazy" /></div>
        <div class="experience-copy"><p class="eyebrow">{service.category?.name || "Experiencia"}</p><h3>{service.name}</h3><p>{service.shortDescription}</p><a class="inline-link" href={experienceHref(service.slug)}>Conocé la experiencia <span aria-hidden="true">↗</span></a></div>
      </article>;
    })}
    <div class="section-action"><a class="inline-link" href={experienceHref()}>{block?.primaryCta?.label || "Ver todas las Experiencias Boho"} <span aria-hidden="true">↗</span></a></div>
  </div>}
</section>
