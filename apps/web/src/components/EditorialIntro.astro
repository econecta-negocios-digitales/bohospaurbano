---
import type { HomeBlock } from "../lib/sanity/types";
import { imageAlt, localImages, portableTextToString } from "../lib/site";
import { sanityImageUrl } from "../lib/sanity";

interface Props { block?: HomeBlock }
const { block } = Astro.props;
const image = sanityImageUrl(block?.image, { width: 1000, quality: 78 }) || localImages.intro;
const copy = block?.description || portableTextToString(block?.content) || "Un espacio íntimo para bajar el ritmo, recibir atención personalizada y volver a vos.";
---

<section class="section intro-section" id="propuesta" aria-labelledby="intro-title">
  <div class="editorial-grid intro-grid">
    <div class="image-frame image-frame-tall"><img src={image} alt={imageAlt(block?.image, "Productos y texturas de cuidado en Boho")} width="1000" height="1200" loading="lazy" /></div>
    <div class="intro-copy">
      <p class="eyebrow">{block?.eyebrow || "La propuesta Boho"}</p>
      <h2 id="intro-title">{block?.title || "Cuidarte también puede ser una forma de hacer pausa."}</h2>
      <p>{copy}</p>
      <div class="intro-details"><span>01</span><span>Atención personalizada</span><span>02</span><span>Técnicas manuales</span></div>
      <a class="inline-link" href="#por-que-boho">{block?.primaryCta?.label || "Conocé nuestra forma de trabajar"} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
