---
import type { HomeBlock } from "../lib/sanity/types";
import { imageAlt, localImageSrcSet, localImages, parseHomeAboutContent } from "../lib/site";
import { sanityImageSrcSet, sanityImageUrl } from "../lib/sanity";

interface Props { block?: HomeBlock }
const { block } = Astro.props;
const image = sanityImageUrl(block?.image, { width: 1000, quality: 78 }) || localImages.intro;
const imageSrcSet = sanityImageSrcSet(block?.image, [480, 768, 1000], 78) || localImageSrcSet(localImages.intro, [480, 768, 1000]);
const parsed = parseHomeAboutContent(block?.content);
const copy = block?.description || parsed.mainText || "Un espacio íntimo para bajar el ritmo, recibir atención personalizada y volver a vos.";
---

<section class="section intro-section" id="propuesta" aria-labelledby="intro-title">
  <div class="editorial-grid intro-grid">
    <div class="image-frame image-frame-tall"><img src={image} srcset={imageSrcSet} sizes="(min-width: 801px) 50vw, 100vw" alt={imageAlt(block?.image, "Productos y texturas de cuidado en Boho")} width="1000" height="1250" loading="lazy" /></div>
    <div class="intro-copy">
      <p class="eyebrow">{block?.eyebrow || parsed.eyebrow || "La propuesta Boho"}</p>
      <h2 id="intro-title">{block?.title || parsed.title || "Cuidarte también puede ser una forma de hacer pausa."}</h2>
      <p>{copy}</p>
      <div class="intro-details"><span>01</span><span>Atención personalizada</span><span>02</span><span>Técnicas manuales</span></div>
      <a class="inline-link" href="/nosotros/">{block?.primaryCta?.label || parsed.cta || "Conocé nuestra forma de trabajar"} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
