---
import type { HomeBlock, ServiceCategory } from "../lib/sanity/types";
import { imageAlt, localImageSrcSet, localImages, publicRoutes, routeForLabel } from "../lib/site";
import { sanityImageSrcSet, sanityImageUrl } from "../lib/sanity";

interface Props { block?: HomeBlock; categories: ServiceCategory[] }
const { block, categories } = Astro.props;
const fallbacks = [localImages.experiences, localImages.massage, localImages.facial, localImages.beauty];
---

<section class="section categories-section" id="categorias" aria-labelledby="categories-title">
  <div class="section-heading section-heading-wide">
    <div><p class="eyebrow">{block?.eyebrow || "Elegí cómo querés sentirte"}</p><h2 id="categories-title">{block?.title || "Cuatro formas de entrar en pausa"}</h2></div>
  </div>
  <div class="category-mosaic">
    {categories.slice(0, 4).map((category, index) => {
      const fallback = fallbacks[index] || localImages.experiences;
      const image = sanityImageUrl(category.image, { width: 1000, quality: 76 }) || fallback;
      const imageSrcSet = sanityImageSrcSet(category.image, [480, 768, 1000], 76) || localImageSrcSet(fallback, [480, 768, 1000]);
      const slug = routeForLabel(category.name) || "/servicios/#categorias";
      return <a class={`category-tile category-tile-${index + 1}`} href={slug}>
        <img src={image} srcset={imageSrcSet} sizes="(min-width: 801px) 50vw, calc(100vw - 2.5rem)" alt={imageAlt(category.image, category.name)} width="1000" height="1334" loading="lazy" />
        <span class="category-shade"></span><span class="category-label"><small>Boho</small><strong>{category.name}</strong></span>
      </a>;
    })}
  </div>
  <div class="section-action"><a class="inline-link" href={publicRoutes.servicios}>{block?.primaryCta?.label || "Ver todos los servicios"} <span aria-hidden="true">↗</span></a></div>
</section>
