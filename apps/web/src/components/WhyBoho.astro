---
import type { HomeBlock } from "../lib/sanity/types";
import { imageAlt, parseHomeAboutContent } from "../lib/site";

interface Props { block?: HomeBlock }
const { block } = Astro.props;
const image = "/images/home/why-boho-home.webp";
const copy = parseHomeAboutContent(block?.content);
---

<section class="section why-section" id="por-que-boho" aria-labelledby="why-title">
  <div class="editorial-grid why-grid"><div class="why-copy"><p class="eyebrow">{copy.eyebrow || block?.eyebrow || "Por qué Boho"}</p><h2 id="why-title">{copy.title || "El cuidado está en cada detalle."}</h2><p>{copy.mainText}</p><ul class="detail-list">{copy.highlights.map((item) => <li>{item}</li>)}</ul><p>{copy.institutional}</p><a class="inline-link" href="/nosotros/">{copy.cta || "Conocer Boho"} <span aria-hidden="true">↗</span></a></div><div class="image-frame image-frame-tall"><img src={image} alt={imageAlt(block?.image, "Detalle de un ritual de cuidado en Boho")} width="1000" height="1200" loading="lazy" /></div></div>
</section>
