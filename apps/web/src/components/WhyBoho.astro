---
import type { HomeBlock } from "../lib/sanity/types";
import { imageAlt, localImages, portableTextToString } from "../lib/site";

interface Props { block?: HomeBlock }
const { block } = Astro.props;
const image = localImages.whyBoho;
const copy = block?.description || portableTextToString(block?.content) || "Boho está pensado para acompañarte con cuidado, técnicas manuales y productos elegidos con atención.";
---

<section class="section why-section" id="por-que-boho" aria-labelledby="why-title">
  <div class="editorial-grid why-grid"><div class="why-copy"><p class="eyebrow">{block?.eyebrow || "Por qué Boho"}</p><h2 id="why-title">El cuidado está en cada detalle.</h2><p>{copy}</p><ul class="detail-list"><li>Atención personalizada</li><li>Protocolos y técnicas manuales</li><li>Cosmética seleccionada</li><li>Un ambiente íntimo para bajar el ritmo</li></ul><a class="inline-link" href="#contacto">{block?.primaryCta?.label || "Conocé más sobre Boho"} <span aria-hidden="true">↗</span></a></div><div class="image-frame image-frame-tall"><img src={image} alt={imageAlt(block?.image, "Detalle de un ritual de cuidado en Boho")} width="1000" height="1200" loading="lazy" /></div></div>
</section>
