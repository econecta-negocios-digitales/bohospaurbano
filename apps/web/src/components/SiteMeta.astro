---
import Analytics from "./Analytics.astro";
import { canonicalHref } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = canonicalHref(Astro.url.pathname);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---

<link rel="canonical" href={canonical} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
{noindex && <meta name="robots" content="noindex,nofollow" />}
{verification && <meta name="google-site-verification" content={verification} />}
<Analytics />
