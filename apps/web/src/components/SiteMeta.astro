---
import Analytics from "./Analytics.astro";
import { BOHO_SITE_URL, bohoLocalBusinessJsonLd, canonicalHref } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = canonicalHref(Astro.url.pathname);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const ogImage = new URL("/brand/opengraph-boho.webp", BOHO_SITE_URL).toString();
---

<link rel="canonical" href={canonical} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1731" />
<meta property="og:image:height" content="909" />
<meta property="og:image:alt" content="Boho Spa Urbano en Bahía Blanca" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(bohoLocalBusinessJsonLd)} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
{verification && <meta name="google-site-verification" content={verification} />}
<Analytics />
