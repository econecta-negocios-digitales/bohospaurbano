---
import type { Testimonial } from "../lib/sanity/types";

interface Props { testimonials: Testimonial[] }
const { testimonials } = Astro.props;
---

{testimonials.length > 0 && <section class="section reviews-section" id="opiniones" aria-labelledby="reviews-title">
  <div class="section-heading"><div><p class="eyebrow">Experiencias reales</p><h2 id="reviews-title">Lo que se llevan de Boho.</h2></div><p>Reseñas compartidas por personas que ya hicieron una pausa con nosotras.</p></div>
  <div class="reviews-grid">{testimonials.slice(0, 3).map((review) => <figure class="review"><div class="stars" aria-label="5 estrellas">★★★★★</div><blockquote>“{review.text}”</blockquote><figcaption>{review.publicName}{review.date && <time datetime={review.date}> · {review.date}</time>}</figcaption></figure>)}</div>
</section>}
