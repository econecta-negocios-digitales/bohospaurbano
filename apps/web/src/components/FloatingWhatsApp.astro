---
import type { SiteSettings } from "../lib/sanity/types";
import { whatsappHref } from "../lib/site";
interface Props { settings?: SiteSettings | null }
const { settings } = Astro.props;
---
<a class="floating-whatsapp" href={whatsappHref(settings)} aria-label="Consultar por WhatsApp" target="_blank" rel="noopener noreferrer" data-boho-track="whatsapp_click" data-boho-track-context="floating_whatsapp"><span aria-hidden="true">◌</span><span>WhatsApp</span></a>
