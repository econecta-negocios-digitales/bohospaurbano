---
import type { Footer, SiteSettings } from "../lib/sanity/types";
import { currentPhaseRoute, hrefForCta, whatsappHref } from "../lib/site";
import GoogleMapFooter from "./GoogleMapFooter.astro";
interface Props { footer?: Footer | null; settings?: SiteSettings | null }
const { footer, settings } = Astro.props;
const socialLinks = settings?.socialLinks?.filter((social) => social.url?.startsWith("https://")) || [];
const instagramLink = socialLinks.find((social) => social.network?.toLowerCase() === "instagram");
const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY;
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID;
const columns = footer?.columns?.filter((column) => column.visible !== false) || [];
const isHome = Astro.url.pathname === "/";
const footerHref = (label: string | undefined) => currentPhaseRoute(label, isHome);
const legalHref = (link: { label?: string }) => {
  const key = link.label?.trim().toLowerCase();
  if (key === "privacidad") return "/privacidad/";
  if (key === "términos y condiciones" || key === "terminos y condiciones") return "/terminos-y-condiciones/";
  if (key === "preguntas frecuentes" || key === "faq") return "/preguntas-frecuentes/";
  return footerHref(link.label);
};
---
<footer class="site-footer"><div class="footer-brand"><a class="brand" href="/" aria-label="Boho Spa Urbano, inicio"><img src="/brand/logo-boho-white.webp" alt="Boho Spa Urbano" width="150" height="68" /></a><p>{settings?.contact?.address || "Santa Fe 157"}<br />{settings?.contact?.city || "Bahía Blanca"}</p><a class="footer-whatsapp" href={whatsappHref(settings)} target="_blank" rel="noopener noreferrer" data-boho-track="whatsapp_click" data-boho-track-context="footer">Consultar por WhatsApp</a></div><GoogleMapFooter mapsKey={mapsKey} mapId={mapId} /><div class="footer-columns">{columns.map((column) => <div><p class="footer-label">{column.title}</p>{column.links?.map((link) => <a href={hrefForCta(link, footerHref(link.label))} data-boho-track={link.link?.type === "booking" ? "reservation_click" : link.link?.type === "whatsapp" ? "whatsapp_click" : undefined} data-boho-track-context="footer">{link.label}</a>)}</div>)}{columns.length === 0 && <div><p class="footer-label">Explorar</p><a href={footerHref("Servicios")}>Servicios</a><a href={footerHref("Experiencias")}>Experiencias</a><a href={footerHref("Gift Cards")}>Gift Cards</a><a href="/regalos-corporativos/">Regalos corporativos</a></div>}{footer?.legalLinks?.length ? <div><p class="footer-label">Legal</p>{footer.legalLinks.map((link) => <a href={legalHref(link)}>{link.label}</a>)}</div> : <div><p class="footer-label">Legal</p><a href="/preguntas-frecuentes/">Preguntas Frecuentes</a><a href="/privacidad/">Privacidad</a><a href="/terminos-y-condiciones/">Términos y Condiciones</a></div>}<div>{instagramLink && <><p class="footer-label">Seguinos</p><a class="footer-instagram" href={instagramLink.url} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Boho Spa Urbano"><svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg><span>{instagramLink.label || "Instagram"}</span></a></>}</div></div><div class="footer-preferences-row"><button class="footer-preferences" type="button" data-boho-preferences>Preferencias de privacidad</button></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Boho Spa Urbano</span><span>Un refugio en la ciudad.</span></div></footer>
