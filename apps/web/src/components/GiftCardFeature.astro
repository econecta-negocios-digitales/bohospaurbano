---
import type { HomeBlock, SiteSettings } from "../lib/sanity/types";
import { imageAlt, localImages, whatsappHref } from "../lib/site";
import { sanityImageUrl } from "../lib/sanity";

interface Props { block?: HomeBlock; settings?: SiteSettings | null }
const { block, settings } = Astro.props;
const image = sanityImageUrl(block?.image, { width: 1300, quality: 78 }) || localImages.giftCard;
---

<section class="gift-section" id="gift-cards" aria-labelledby="gift-title">
  <div class="gift-image"><img src={image} alt={imageAlt(block?.image, "Gift Card de Boho Spa Urbano")} width="1300" height="900" loading="lazy" /></div>
  <div class="gift-copy"><p class="eyebrow">{block?.eyebrow || "Gift Cards Boho"}</p><h2 id="gift-title">Regalá un momento para disfrutar.</h2><p>{block?.description || "Hay regalos que se usan y otros que se viven. Elegí una experiencia y dejá que Boho prepare el resto."}</p><a class="button button-light" href={block?.primaryCta?.link?.externalUrl || "#contacto"}>{block?.primaryCta?.label || "Ver Gift Cards"}</a><a class="gift-whatsapp" href={whatsappHref(settings)}>También podemos ayudarte por WhatsApp ↗</a></div>
</section>
