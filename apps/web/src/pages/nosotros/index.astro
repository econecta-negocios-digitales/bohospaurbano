---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import InternalPageHero from '../../components/InternalPageHero.astro';
import AboutEditorial from '../../components/AboutEditorial.astro';
import ContactReservation from '../../components/ContactReservation.astro';
import ConversionClose from '../../components/ConversionClose.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { loadAboutPage, loadFooter, loadNavigation, loadSiteSettings } from '../../lib/sanity';
import { editorialField, editorialSections } from '../../lib/site';

const [page, settings, navigation, footer] = await Promise.all([
  loadAboutPage(),
  loadSiteSettings(),
  loadNavigation(),
  loadFooter(),
]);
const source = page?.intro;
const sections = editorialSections(source);
const headerSection = sections.find((section) => section.heading.toLowerCase() === 'encabezado');
const title = page?.title || headerSection?.paragraphs[1] || editorialField(source, 'Título');
const description = headerSection?.paragraphs[2] || editorialField(source, 'Texto');
const eyebrow = headerSection?.paragraphs[0] || editorialField(source, 'Antetítulo');
const story = sections.find((section) => section.heading.toLowerCase() === 'nuestra historia');
const knowledge = sections.find((section) => section.heading.toLowerCase().includes('conocimiento, experiencia'));
const practicesIndex = sections.findIndex((section) => section.heading.toLowerCase() === 'nuestra forma de trabajar');
const practices = practicesIndex >= 0
  ? sections.slice(practicesIndex + 1).filter((section) => section.level === 3).slice(0, 5)
  : [];
const seoTitle = page?.seo?.title || 'Nosotros | Boho Spa Urbano Bahía Blanca';
const seoDescription = page?.seo?.description || 'Conocé la esencia de Boho Spa Urbano y nuestra forma personalizada de trabajar el bienestar en Bahía Blanca.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seoDescription} />
    <title>{seoTitle}</title>
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader navigation={navigation} settings={settings} />
    <main id="contenido">
      <InternalPageHero eyebrow={eyebrow} title={title || 'Nosotros'} description={description} image={page?.image} fallbackImage="/images/internal/nosotros-hero.webp" />
      <AboutEditorial story={story} knowledge={knowledge} practices={practices} practicesTitle={practicesIndex >= 0 ? sections[practicesIndex]?.heading : undefined} />
      <ContactReservation settings={settings} />
      <ConversionClose settings={settings} />
    </main>
    <SiteFooter footer={footer} settings={settings} />
    <FloatingWhatsApp settings={settings} />
  </body>
</html>
