---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import SiteMeta from '../../components/SiteMeta.astro';
import ConsentBanner from '../../components/ConsentBanner.astro';
import { loadFooter, loadGiftCardsPage, loadNavigation, loadSiteSettings } from '../../lib/sanity';
import { editorialSections, whatsappHref } from '../../lib/site';

const [page, navigation, footer, settings] = await Promise.all([
  loadGiftCardsPage(), loadNavigation(), loadFooter(), loadSiteSettings(),
]);
if (!page) return Astro.redirect('/servicios/');

const sections = editorialSections(page.content);
const topLevelSections = sections.filter((section) => section.level === 2);
const numberedSection = (number: number) => topLevelSections.find((section) => section.heading.match(/^(\d+)/)?.[1] === String(number));
const heading = topLevelSections.find((section) => !/^\d+\.\s/.test(section.heading)) || topLevelSections[0];
const heroParagraphs = heading?.paragraphs || [];
const heroDescription = heroParagraphs.slice(0, 2).join(' ') ||
  'Hay regalos que se usan y otros que se viven. Elegí una experiencia y dejá que Boho prepare el resto.';
const metaDescription = page.seo?.description || page.description || 'Regalá masajes, tratamientos y experiencias de spa con Gift Cards Boho en Bahía Blanca.';
const metaTitle = page.seo?.title || page.title || 'Gift Cards | Boho Spa Urbano';
const sectionText = (section: typeof sections[number] | undefined, fallback: string) => section?.paragraphs.filter(Boolean).join(' ') || fallback;
const optionSections: (typeof sections[number] | undefined)[] = sections.filter((section) => section.level === 3).slice(0, 3);
const giftOptions = [
  {
    eyebrow: '01 · Una experiencia concreta',
    title: optionSections[0]?.heading || 'Regalá un servicio',
    text: sectionText(optionSections[0], 'Elegí uno de nuestros masajes, tratamientos o propuestas de cuidado personal para regalar un momento que ya sabés que esa persona va a disfrutar.'),
  },
  {
    eyebrow: '02 · Un momento para compartir',
    title: optionSections[1]?.heading || 'Regalá una Experiencia Boho',
    text: sectionText(optionSections[1], 'Una propuesta integral para regalar algo más que un tratamiento: distintos momentos de bienestar dentro de una misma experiencia.'),
  },
  {
    eyebrow: '03 · Libertad para elegir',
    title: optionSections[2]?.heading || 'Regalá un importe',
    text: sectionText(optionSections[2], 'Podés elegir un monto determinado para que quien recibe la Gift Card decida cómo utilizarlo en Boho.'),
  },
];
const steps = [
  ['Elegís qué regalar', 'Un servicio, una experiencia o un importe determinado.'],
  ['Nos contás para quién es', 'Podemos sumar el nombre y una dedicatoria personal.'],
  ['Elegís cómo recibirla', 'Digital, con envío por WhatsApp, o física para retirar en Boho.'],
  ['La persona coordina su momento', 'La reserva se gestiona con Boho según disponibilidad.'],
];
const processSection = numberedSection(5);
const processParagraphs = processSection?.paragraphs || [];
const processTitle = processParagraphs[0] || 'Simple para regalar. Simple para disfrutar.';
const termsSection = numberedSection(6);
const terms = [
  'Tiene una vigencia de 30 días.',
  'Es personal y no transferible.',
  'Puede cambiarse por otro servicio del mismo valor.',
  'Puede usarse como crédito para uno de mayor valor abonando la diferencia.',
  'No es acumulable con promociones.',
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <title>{metaTitle}</title>
    <SiteMeta title={metaTitle} description={metaDescription} />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader navigation={navigation} settings={settings} />
    <main id="contenido" class="gift-page">
      <section class="gift-hero" aria-labelledby="gift-hero-title">
        <div class="gift-hero-copy">
          <p class="eyebrow">{heroParagraphs[0] || 'Gift Cards Boho'}</p>
          <h1 id="gift-hero-title">{heroParagraphs[1] || page.title || 'Regalá un momento para disfrutar'}</h1>
          <p>{heroDescription}</p>
          <a class="button button-primary" href={whatsappHref(settings)} target="_blank" rel="noopener noreferrer" data-boho-track="gift_card_contact" data-boho-track-context="gift_card_hero">Consultar por WhatsApp</a>
        </div>
        <div class="gift-hero-media">
          <img src="/images/home/gift-card.webp" alt="Gift Card Boho dentro de su packaging real" width="1200" height="1800" fetchpriority="high" />
        </div>
      </section>

      <section class="section gift-options" aria-labelledby="gift-options-title">
        <div class="section-heading">
          <div><p class="eyebrow">Elegí cómo regalar</p><h2 id="gift-options-title">Un regalo pensado para esa persona</h2></div>
          <p>Podés regalar una experiencia específica o dejar abierta la elección. Nosotros preparamos cada Gift Card para que regalar bienestar sea simple y especial.</p>
        </div>
        <div class="gift-options-grid">
          {giftOptions.map((option) => <article class="gift-option"><p class="eyebrow">{option.eyebrow}</p><h3>{option.title}</h3><p>{option.text}</p></article>)}
        </div>
      </section>

      <section class="gift-process" aria-labelledby="gift-process-title">
        <div class="gift-process-heading"><p class="eyebrow">Cómo funciona</p><h2 id="gift-process-title">{processTitle}</h2></div>
        <div class="gift-steps">
          {steps.map(([title, text], index) => <div class="gift-step"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></div>)}
        </div>
      </section>

      <section class="section gift-terms" aria-labelledby="gift-terms-title">
        <div class="gift-terms-copy"><p class="eyebrow">Para tener en cuenta</p><h2 id="gift-terms-title">{termsSection?.paragraphs[0] || 'Información importante sobre tu Gift Card'}</h2><p>Queremos que regalar sea simple. Estas son las principales condiciones para usar tu Gift Card Boho.</p><a class="button button-primary" href={whatsappHref(settings)} target="_blank" rel="noopener noreferrer" data-boho-track="gift_card_contact" data-boho-track-context="gift_card_terms">Comprar mi Gift Card</a></div>
        <div><ul class="gift-terms-list">{terms.map((term) => <li>{term}</li>)}</ul><p class="gift-terms-note">¿Querés comprar 2 o más Gift Cards? Escribinos por WhatsApp y te ayudamos a coordinarlas.</p></div>
      </section>

      <section class="gift-close" aria-labelledby="gift-close-title">
        <p class="eyebrow">Tu regalo empieza acá</p>
        <h2 id="gift-close-title">Hablemos de la Gift Card que imaginaste</h2>
        <p>Escribinos y te ayudamos a elegir entre un servicio, una experiencia o un importe determinado.</p>
        <a class="button button-light" href={whatsappHref(settings)} target="_blank" rel="noopener noreferrer" data-boho-track="gift_card_contact" data-boho-track-context="gift_card_close">Consultar por WhatsApp</a>
      </section>
    </main>
    <SiteFooter footer={footer} settings={settings} />
    <FloatingWhatsApp settings={settings} />
    <ConsentBanner />
  </body>
</html>
