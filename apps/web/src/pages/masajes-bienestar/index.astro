---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import InternalPageHero from '../../components/InternalPageHero.astro';
import ContactReservation from '../../components/ContactReservation.astro';
import ConversionClose from '../../components/ConversionClose.astro';
import CategoryServiceList from '../../components/CategoryServiceList.astro';
import { whatsappHref } from '../../lib/site';
import { categoryField, sectionByHeading, sectionEyebrow, sectionTitle, servicesForCategory, technicalCategoryDescription, technicalCategoryTitle } from '../../lib/categoryPresentation';
import { loadCategories, loadServices, loadFooter, loadNavigation, loadSiteSettings } from '../../lib/sanity';

const [categories, services, settings, navigation, footer] = await Promise.all([
  loadCategories(), loadServices(), loadSiteSettings(), loadNavigation(), loadFooter(),
]);
const category = categories.find((item) => item.slug === 'masajes-bienestar');
if (!category) return Astro.redirect('/servicios/');
const introSection = sectionByHeading(category, /una pausa que empieza/i);
const serviceSection = sectionByHeading(category, /masajes destacados/i);
const guidanceSection = sectionByHeading(category, /qué masaje elegir/i);
const categoryServices = servicesForCategory(category, services);
const featured = categoryServices[0]!;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={technicalCategoryDescription(category)} />
    <title>{technicalCategoryTitle(category)}</title>
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader navigation={navigation} settings={settings} />
    <main id="contenido">
      <InternalPageHero eyebrow={categoryField(category, 'Antetítulo') || category.name} title={categoryField(category, 'Título de portada') || category.name} description={category.description || ''} fallbackImage="/images/categories/masaje-renovacion.webp" />
      <section class="section massage-intro" aria-labelledby="massage-intro-title">
        <div class="massage-intro-layout">
          <div>
            <div class="section-heading"><div><p class="eyebrow">{introSection?.heading}</p><h2 id="massage-intro-title">{sectionTitle(introSection) || introSection?.heading}</h2></div>{introSection?.paragraphs[0] && <p>{introSection.paragraphs[0]}</p>}</div>
            <div class="massage-intro-detail">{introSection?.paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}<div class="massage-detail-line"><span>{categoryField(category, 'Detalle 1')}</span><span>{categoryField(category, 'Detalle 2')}</span><span>{categoryField(category, 'Detalle 3')}</span></div></div>
          </div>
          <div class="image-frame massage-intro-media"><img src="/images/categories/masaje-pausa.webp" alt="Masaje corporal en una pausa de bienestar" width="800" height="1618" loading="lazy" /></div>
        </div>
      </section>
      <section class="section massage-services" aria-labelledby="massage-services-title">
        <div class="section-heading"><div><p class="eyebrow">{sectionEyebrow(serviceSection, serviceSection?.heading || category.name)}</p><h2 id="massage-services-title">{sectionTitle(serviceSection) || serviceSection?.heading}</h2></div>{serviceSection?.paragraphs[0] && <p>{serviceSection.paragraphs[0]}</p>}</div>
        <article class="massage-featured">
          <div class="massage-featured-copy"><p class="eyebrow">01 · {serviceSection?.heading || category.name}</p><h3>{featured.name}</h3><p class="category-service-lead">{featured.description}</p>{featured.detail && <p>{featured.detail}</p>}</div>
          <div class="image-frame"><img src="/images/categories/masaje-renovacion.webp" alt="Masaje corporal manual en Boho" width="960" height="1200" /></div>
        </article>
        <CategoryServiceList services={categoryServices.slice(1)} />
        <div class="massage-service-visuals" aria-label="Técnicas corporales destacadas">
          <figure><img src="/images/categories/reflexologia-podal.webp" alt="Reflexología podal en Boho" width="960" height="1200" loading="lazy" /><figcaption>Reflexología Podal</figcaption></figure>
          <figure><img src="/images/categories/drenaje-linfatico.webp" alt="Drenaje linfático manual en Boho" width="960" height="1200" loading="lazy" /><figcaption>Drenaje Linfático Manual</figcaption></figure>
        </div>
      </section>
      <section class="section massage-orientation" aria-labelledby="massage-orientation-title">
        <div class="massage-orientation-copy"><p class="eyebrow">{guidanceSection?.heading}</p><h2 id="massage-orientation-title">{sectionTitle(guidanceSection) || guidanceSection?.heading}</h2>{guidanceSection?.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{guidanceSection?.fields["cta principal"] && <a class="button button-primary" href={whatsappHref()} target="_blank" rel="noopener noreferrer">{guidanceSection.fields["cta principal"]}</a>}</div>
        <div class="massage-orientation-notes"><span>Masaje</span><span>Reflexología</span><span>Drenaje</span></div>
      </section>
      <ContactReservation settings={settings} />
      <ConversionClose settings={settings} />
    </main>
    <SiteFooter footer={footer} settings={settings} />
    <FloatingWhatsApp settings={settings} />
  </body>
</html>
