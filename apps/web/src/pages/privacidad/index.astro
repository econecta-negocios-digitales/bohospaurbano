---
import LegalPage from "../../components/LegalPage.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { loadFooter, loadNavigation, loadPrivacyPage, loadSiteSettings } from "../../lib/sanity";

const [page, navigation, footer, settings] = await Promise.all([loadPrivacyPage(), loadNavigation(), loadFooter(), loadSiteSettings()]);
if (!page) return Astro.redirect("/");
---

<SiteLayout title={page.seo?.title || page.title || "Política de Privacidad | Boho Spa Urbano"} description={page.seo?.description}>
  <LegalPage page={page} navigation={navigation} footer={footer} settings={settings} />
</SiteLayout>
