{
  "name": "bohospaurbano",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "build:web": "npm run build --workspace=apps/web",
    "build:studio": "npm run build --workspace=apps/studio",
    "typecheck": "npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/studio",
    "build": "npm run build:web && npm run build:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
